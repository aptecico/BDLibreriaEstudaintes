START TRANSACTION;

-- Seleccionar un producto activo con suficiente inventario
SELECT id, stock
INTO @producto_prueba, @stock_anterior
FROM productos
WHERE estado = 'activo'
AND stock >= 2
ORDER BY id
LIMIT 1;

-- Seleccionar una venta confirmada
SELECT id
INTO @venta_prueba
FROM ventas
WHERE estado = 'confirmada'
ORDER BY id
LIMIT 1;

-- Insertar una unidad
INSERT INTO detalle_ventas
(venta_id, producto_id, cantidad, precio_unitario)

SELECT
    @venta_prueba,
    id,
    1,
    precio
FROM productos
WHERE id = @producto_prueba;

-- Revisar el inventario
SELECT
    @producto_prueba AS producto,
    @stock_anterior AS stock_anterior,
    stock AS stock_actual,
    @stock_anterior - 1 AS stock_esperado,

    CASE
        WHEN stock = @stock_anterior - 1
            THEN 'CORRECTO'
        ELSE 'ERROR: EL TRIGGER NO DESCONTO EL STOCK'
    END AS resultado

FROM productos
WHERE id = @producto_prueba;

