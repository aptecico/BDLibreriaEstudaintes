SELECT
    p.id,
    p.nombre,
    p.stock_inicial,
    p.stock AS stock_actual,

    p.stock_inicial
    + IFNULL(SUM(mi.cantidad), 0) AS stock_segun_movimientos,

    p.stock -
    (
        p.stock_inicial
        + IFNULL(SUM(mi.cantidad), 0)
    ) AS diferencia,

    CASE
        WHEN p.stock =
            p.stock_inicial + IFNULL(SUM(mi.cantidad), 0)
            THEN 'CORRECTO'
        ELSE 'INCONSISTENCIA'
    END AS diagnostico

FROM productos p

LEFT JOIN movimientos_inventario mi
    ON mi.producto_id = p.id

GROUP BY
    p.id,
    p.nombre,
    p.stock_inicial,
    p.stock

ORDER BY ABS(
    p.stock - (
        p.stock_inicial + IFNULL((
            SELECT SUM(m2.cantidad)
            FROM movimientos_inventario m2
            WHERE m2.producto_id = p.id
        ), 0)
    )
) DESC;





