SELECT
    tipo_movimiento,
    tabla_origen,
    COUNT(*) AS cantidad_movimientos,
    SUM(cantidad) AS unidades
FROM movimientos_inventario
GROUP BY tipo_movimiento, tabla_origen;





SELECT
    dc.id AS detalle_compra,
    c.id AS compra,
    dc.producto_id,
    dc.cantidad AS cantidad_compra,
    mi.cantidad AS cantidad_movimiento,

    CASE
        WHEN mi.id IS NULL THEN 'MOVIMIENTO FALTANTE'
        WHEN mi.cantidad <> dc.cantidad THEN 'CANTIDAD INCORRECTA'
        ELSE 'CORRECTO'
    END AS diagnostico

FROM detalle_compras dc

INNER JOIN compras c
    ON c.id = dc.compra_id

LEFT JOIN movimientos_inventario mi
    ON mi.detalle_origen_id = dc.id
    AND mi.tabla_origen = 'detalle_compras'

WHERE c.estado = 'recibida'

AND (
    mi.id IS NULL
    OR mi.cantidad <> dc.cantidad
)

ORDER BY dc.producto_id;




SELECT
    dv.id AS detalle_venta,
    v.id AS venta,
    dv.producto_id,
    dv.cantidad AS cantidad_venta,
    mi.cantidad AS cantidad_movimiento,

    CASE
        WHEN mi.id IS NULL THEN 'MOVIMIENTO FALTANTE'
        WHEN mi.cantidad <> -dv.cantidad THEN 'CANTIDAD INCORRECTA'
        ELSE 'CORRECTO'
    END AS diagnostico

FROM detalle_ventas dv

INNER JOIN ventas v
    ON v.id = dv.venta_id

LEFT JOIN movimientos_inventario mi
    ON mi.detalle_origen_id = dv.id
    AND mi.tabla_origen = 'detalle_ventas'

WHERE v.estado = 'confirmada'

AND (
    mi.id IS NULL
    OR mi.cantidad <> -dv.cantidad
)

ORDER BY dv.producto_id;



