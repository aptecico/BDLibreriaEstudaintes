SELECT
    p.id,
    p.nombre,
    p.stock_inicial,

    IFNULL((
        SELECT SUM(dc.cantidad)
        FROM detalle_compras dc
        INNER JOIN compras c ON c.id = dc.compra_id
        WHERE dc.producto_id = p.id
        AND c.estado = 'recibida'
    ), 0) AS compras,

    IFNULL((
        SELECT SUM(dv.cantidad)
        FROM detalle_ventas dv
        INNER JOIN ventas v ON v.id = dv.venta_id
        WHERE dv.producto_id = p.id
        AND v.estado = 'confirmada'
    ), 0) AS ventas,

    fn_stock_esperado(p.id) AS stock_esperado,

    p.stock AS stock_actual,

    p.stock - fn_stock_esperado(p.id) AS diferencia,

    CASE
        WHEN p.stock = fn_stock_esperado(p.id)
            THEN 'CORRECTO'
        WHEN p.stock > fn_stock_esperado(p.id)
            THEN 'SOBRANTE'
        ELSE 'FALTANTE'
    END AS estado

FROM productos p

WHERE p.stock <> fn_stock_esperado(p.id)

ORDER BY ABS(p.stock - fn_stock_esperado(p.id)) DESC;

