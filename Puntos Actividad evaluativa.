START TRANSACTION;

-- Buscar un detalle confirmado cuyo producto tenga stock
SELECT
    dv.id,
    dv.producto_id,
    dv.cantidad,
    p.stock

INTO
    @detalle_prueba,
    @producto_prueba,
    @cantidad_anterior,
    @stock_anterior

FROM detalle_ventas dv
INNER JOIN ventas v ON v.id = dv.venta_id
INNER JOIN productos p ON p.id = dv.producto_id

WHERE v.estado = 'confirmada'
AND p.stock >= 1
ORDER BY dv.id
LIMIT 1;

-- Aumentar una unidad en el detalle
UPDATE detalle_ventas
SET cantidad = @cantidad_anterior + 1
WHERE id = @detalle_prueba;

-- Comprobar el resultado
SELECT
    @cantidad_anterior AS cantidad_anterior,
    cantidad AS cantidad_nueva,
    @stock_anterior AS stock_anterior,
    stock AS stock_actual,

    CASE
        WHEN stock = @stock_anterior - 1
            THEN 'CORRECTO'
        ELSE 'ERROR EN EL TRIGGER UPDATE'
    END AS resultado

FROM detalle_ventas dv
INNER JOIN productos p
    ON p.id = dv.producto_id

WHERE dv.id = @detalle_prueba;

SELECT *
FROM auditoria
ORDER BY id DESC
LIMIT 10;

