SELECT
    p.id,
    p.nombre,
    p.stock_inicial,

    IFNULL((
        SELECT SUM(dc.cantidad)
        FROM detalle_compras dc
        INNER JOIN compras c
            ON c.id = dc.compra_id
        WHERE dc.producto_id = p.id
        AND c.estado = 'recibida'
    ), 0) AS total_comprado,

    IFNULL((
        SELECT SUM(dv.cantidad)
        FROM detalle_ventas dv
        INNER JOIN ventas v
            ON v.id = dv.venta_id
        WHERE dv.producto_id = p.id
        AND v.estado = 'confirmada'
    ), 0) AS total_vendido,

    p.stock_inicial
    +
    IFNULL((
        SELECT SUM(dc.cantidad)
        FROM detalle_compras dc
        INNER JOIN compras c
            ON c.id = dc.compra_id
        WHERE dc.producto_id = p.id
        AND c.estado = 'recibida'
    ), 0)
    -
    IFNULL((
        SELECT SUM(dv.cantidad)
        FROM detalle_ventas dv
        INNER JOIN ventas v
            ON v.id = dv.venta_id
        WHERE dv.producto_id = p.id
        AND v.estado = 'confirmada'
    ), 0) AS esperado_calculado,

    fn_stock_esperado(p.id) AS resultado_funcion

FROM productos p
ORDER BY p.id;

